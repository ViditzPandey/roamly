<% layout("/layouts/boilerplate")%>

    <div class="row mt-3">
        <div class="col-8 offset-2">

            <h3>
                <%=idList.title%>&#58;
            </h3>
        </div>
        <div class="card col-6 offset-3 show-card listing-card">
            <img src="<%=idList.image%>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <br>
                    <%=idList.description%>
                        <br>
                        &#8377;<%=idList.price.toLocaleString("en-IN")%>
                            <br>
                            <%=idList.location%>
                                <br>
                                <%=idList.country%>
                </p>
            </div>
        </div>

        <br>
        <div class="btns">

            <a href="/listings/<%=idList._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>

            <form method="post" action="/listings/<%=idList._id%>?_method=DELETE">
                <button class="btn btn-dark offset-5">Delete</button>
            </form>
        </div>

        <hr>
        <div class="col-8 offset-3 mb-5">
            <h4>Leave a Review</h4>
            <form action="/listings/<%=idList._id%>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment">Comment</label>
                    <textarea name="review[comment]" id="comment" class="form-control" cols="30" rows="8"
                        required></textarea>
                    <div class="invalid-feedback">Please submit some comments for review</div>
                </div>
                <!-- <br> -->
                <button class="btn btn-outline-dark">Submit</button>
            </form>

            <hr>

            <p><b>All Reviews</b></p>
            <div class="row">
                <%for(review of idList.reviews) {%>
                    <div class="card col-5 mb-3 ms-2">
                        <div class="card-body">
                            <h5 class="card-title">Vidit</h5>
                            <p class="card-text">
                                <%=review.comment%>
                            </p>
                            <p class="card-text">
                                <%=review.rating%>
                            </p>
                        </div>
                        <form action="/listings/<%=idList._id%>/reviews/<%=review._id%>?_method=DELETE" method="post"
                            class="mb-3">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    </div>
                    <%}%>
            </div>
        </div>

    </div>
    <!-- <br> -->